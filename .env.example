# Скопируйте этот файл в .env и подставьте свои ключи:
#   cp .env.example .env

# API-ключ OpenRouter (https://openrouter.ai/keys)
OR_KEY=sk-or-v1-your-openrouter-key

# Модель эмбеддингов (1024 dim)
OR_Model=liquid/lfm-2.5-embedding-350m:free

# API-ключ Pinecone (https://app.pinecone.io/)
Pinecone_API=pcsk_your-pinecone-key
